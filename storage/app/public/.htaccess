# Uploaded files are data only: never execute scripts from this folder.
<FilesMatch "\.(?i:php\d?|phtml|phar|pht|phps|cgi|pl|py|sh|asp|aspx|jsp|htaccess)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .cgi .pl .py
RemoveType .php .phtml .phar

# Stop browsers from treating an uploaded file as HTML/JS.
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
